// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

/// Which business the invoice is billed under. Grateful is GST-registered;
/// Mulberry is not, so its invoices carry no tax breakup.
enum InvoiceBrand {
  GRATEFUL
  MULBERRY
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(MEMBER)
  createdAt    DateTime        @default(now())
  companies    CompanyMember[]
  expenses     Expense[]
  invoices     Invoice[]
}

model Company {
  id               String          @id @default(cuid())
  name             String
  defaultGstPercent Float          @default(18)
  createdAt        DateTime        @default(now())
  members          CompanyMember[]
  gateways         Gateway[]
  categories       Category[]
  expenses         Expense[]
}

model CompanyMember {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Gateway {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  chargePercent Float
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses      Expense[]
}

model Category {
  id        String    @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([companyId, name])
}

model Expense {
  id                  String   @id @default(cuid())
  companyId           String
  categoryId          String
  gatewayId           String?
  description         String?
  date                DateTime
  grossAmount         Float
  gatewayChargePercent Float   @default(0)
  gatewayChargeAmount Float    @default(0)
  gstPercent          Float    @default(0)
  gstAmount           Float    @default(0)
  netAmount           Float
  screenshotPath      String?
  /// Which workbook the expense is mirrored into: "IPC", "IWC" or "MULBERRY"
  /// (see src/lib/ventures.ts). Null for expenses recorded before ventures.
  venture             String?
  /// "IN" = money received (gross -> gateway charge -> GST -> net, written to
  /// the sheet's receipts), "OUT" = a cost (GST-inclusive, written to the
  /// sheet's expenses). Everything logged before the split was money in.
  direction           String   @default("IN")
  createdById         String
  createdAt           DateTime @default(now())

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id])
  gateway    Gateway?  @relation(fields: [gatewayId], references: [id])
  createdBy  User      @relation(fields: [createdById], references: [id])

  @@index([companyId, date])
  @@index([companyId, venture, date])
}

// Invoices raised under either brand, from an uploaded
// Bajaj DO, a GST certificate, or a Mulberry quotation. Seller details are
// fixed (see src/lib/brands.ts) since each brand has one issuing entity.
model Invoice {
  id              String       @id @default(cuid())
  brand           InvoiceBrand @default(GRATEFUL)
  /// "IPC" or "IWC" for Grateful invoices raised under a venture, each with its
  /// own series and sheet. Null for Mulberry and for legacy Grateful invoices.
  venture         String?
  invoiceNumber   String       @unique
  invoiceDate     DateTime
  dueDate         DateTime
  customerName    String
  customerAddress String
  /** Where the invoice gets emailed; captured on the upload screen. */
  customerEmail   String?
  /** When the invoice was last emailed out, so the UI can show it's been sent. */
  emailSentAt     DateTime?
  /** Set when the invoice is edited after it was emailed, so it reads as revised. */
  revisedAt       DateTime?
  /** Present when the invoice was raised from a customer's GST certificate (B2B). */
  customerGstin   String?
  placeOfSupply   String
  itemDescription String
  hsnSac          String
  qty             Float     @default(1)
  grossAmount     Float
  gstPercent      Float     @default(18)
  notes           String?
  terms           String?
  doId            String?
  doDate          DateTime?
  doFilePath      String?
  createdById     String
  createdAt       DateTime  @default(now())

  createdBy User      @relation(fields: [createdById], references: [id])
  payments  Payment[]

  @@index([createdAt])
  @@index([brand, createdAt])
  @@index([brand, venture, createdAt])
}

/// Money actually received against an invoice. Wedding work is paid in
/// instalments, so the balance due is whatever the payments don't yet cover.
model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  paidOn    DateTime
  method    String?
  note      String?
  /// Screenshot or receipt for the transfer, stored like expense proofs.
  proofPath String?
  /// Payment gateway the money came through (e.g. "Razorpay"), which keeps a
  /// commission. `amount` stays what the customer paid, since that is what
  /// settles the invoice; the business receives amount - fee - feeGst.
  gateway      String?
  /// The gateway's own payment id (Razorpay "pay_..."), when it was visible.
  gatewayRef   String?
  feeAmount    Float    @default(0)
  feeGstAmount Float    @default(0)
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Maps a DO's exact loan amount to the item that was actually sold, since
// Bajaj's delivery order never names the product — only its price.
model ItemCatalogEntry {
  id              String   @id @default(cuid())
  amount          Float    @unique
  itemDescription String
  hsnSac          String
  createdAt       DateTime @default(now())
}

/// The covering message sent with an invoice, one per brand. Kept editable
/// because the wording is the business's voice, not something to hard-code.
/// Supports {{customer_name}}, {{invoice_number}}, {{total}}, {{balance_due}},
/// {{invoice_date}}, {{due_date}}, {{item}} and {{brand}} placeholders.
model EmailTemplate {
  brand   InvoiceBrand @id
  subject String
  body    String
}

// Singleton row (id is always "default") holding the invoice-wide defaults
// so terms/notes/signature are set once instead of repeated per invoice.
// The signature is stored inline as a data URI (a few KB) so it renders in
// print/PDF without a second authenticated request for the image.
model InvoiceSettings {
  id               String  @id
  terms            String?
  notes            String?
  signatureDataUri String?
  /// Razorpay's commission on a payment, and the GST it charges on that commission.
  razorpayFeePercent    Float @default(2)
  razorpayFeeGstPercent Float @default(18)
}

/// A sheet write that failed, kept so it can be seen and retried. Rows are
/// resolved when a later write for the same record succeeds.
model SheetSyncFailure {
  id         String    @id @default(cuid())
  ledger     String
  action     String
  recordId   String
  payload    Json
  error      String
  attempts   Int       @default(1)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([resolvedAt])
  @@index([recordId])
}

/// A connection to an outside service, one row per provider ("razorpay").
/// Off until someone turns it on in Settings -> Integrations. The secret is
/// stored encrypted with a key derived from AUTH_SECRET (src/lib/secretBox.ts)
/// and never sent back to the browser.
model Integration {
  provider    String    @id
  enabled     Boolean   @default(false)
  /// Public half of the credentials (Razorpay "rzp_live_..."), shown masked.
  keyId       String?
  secretEnc   String?
  connectedAt DateTime?
  lastError   String?
  updatedAt   DateTime  @updatedAt
}
