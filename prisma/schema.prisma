// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MEMBER
}

/// Which business the invoice is billed under. Grateful is GST-registered;
/// Mulberry is not, so its invoices carry no tax breakup.
enum InvoiceBrand {
  GRATEFUL
  MULBERRY
}

model User {
  id           String          @id @default(cuid())
  name         String
  email        String          @unique
  passwordHash String
  role         Role            @default(MEMBER)
  createdAt    DateTime        @default(now())
  companies    CompanyMember[]
  expenses     Expense[]
  invoices     Invoice[]
}

model Company {
  id               String          @id @default(cuid())
  name             String
  defaultGstPercent Float          @default(18)
  createdAt        DateTime        @default(now())
  members          CompanyMember[]
  gateways         Gateway[]
  categories       Category[]
  expenses         Expense[]
}

model CompanyMember {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Gateway {
  id            String    @id @default(cuid())
  companyId     String
  name          String
  chargePercent Float
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses      Expense[]
}

model Category {
  id        String    @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  expenses  Expense[]

  @@unique([companyId, name])
}

model Expense {
  id                  String   @id @default(cuid())
  companyId           String
  categoryId          String
  gatewayId           String?
  description         String?
  date                DateTime
  grossAmount         Float
  gatewayChargePercent Float   @default(0)
  gatewayChargeAmount Float    @default(0)
  gstPercent          Float    @default(0)
  gstAmount           Float    @default(0)
  netAmount           Float
  screenshotPath      String?
  createdById         String
  createdAt           DateTime @default(now())

  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category   Category  @relation(fields: [categoryId], references: [id])
  gateway    Gateway?  @relation(fields: [gatewayId], references: [id])
  createdBy  User      @relation(fields: [createdById], references: [id])

  @@index([companyId, date])
}

// Invoices raised under either brand, from an uploaded
// Bajaj DO, a GST certificate, or a Mulberry quotation. Seller details are
// fixed (see src/lib/brands.ts) since each brand has one issuing entity.
model Invoice {
  id              String       @id @default(cuid())
  brand           InvoiceBrand @default(GRATEFUL)
  invoiceNumber   String       @unique
  invoiceDate     DateTime
  dueDate         DateTime
  customerName    String
  customerAddress String
  /** Where the invoice gets emailed; captured on the upload screen. */
  customerEmail   String?
  /** When the invoice was last emailed out, so the UI can show it's been sent. */
  emailSentAt     DateTime?
  /** Present when the invoice was raised from a customer's GST certificate (B2B). */
  customerGstin   String?
  placeOfSupply   String
  itemDescription String
  hsnSac          String
  qty             Float     @default(1)
  grossAmount     Float
  gstPercent      Float     @default(18)
  notes           String?
  terms           String?
  doId            String?
  doDate          DateTime?
  doFilePath      String?
  createdById     String
  createdAt       DateTime  @default(now())

  createdBy User      @relation(fields: [createdById], references: [id])
  payments  Payment[]

  @@index([createdAt])
  @@index([brand, createdAt])
}

/// Money actually received against an invoice. Wedding work is paid in
/// instalments, so the balance due is whatever the payments don't yet cover.
model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  amount    Float
  paidOn    DateTime
  method    String?
  note      String?
  /// Screenshot or receipt for the transfer, stored like expense proofs.
  proofPath String?
  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Maps a DO's exact loan amount to the item that was actually sold, since
// Bajaj's delivery order never names the product — only its price.
model ItemCatalogEntry {
  id              String   @id @default(cuid())
  amount          Float    @unique
  itemDescription String
  hsnSac          String
  createdAt       DateTime @default(now())
}

/// The covering message sent with an invoice, one per brand. Kept editable
/// because the wording is the business's voice, not something to hard-code.
/// Supports {{customer_name}}, {{invoice_number}}, {{total}}, {{balance_due}},
/// {{invoice_date}}, {{due_date}}, {{item}} and {{brand}} placeholders.
model EmailTemplate {
  brand   InvoiceBrand @id
  subject String
  body    String
}

// Singleton row (id is always "default") holding the invoice-wide defaults
// so terms/notes/signature are set once instead of repeated per invoice.
// The signature is stored inline as a data URI (a few KB) so it renders in
// print/PDF without a second authenticated request for the image.
model InvoiceSettings {
  id               String  @id
  terms            String?
  notes            String?
  signatureDataUri String?
}
