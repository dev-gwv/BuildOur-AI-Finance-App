# Copy to .env and fill in real values. Never commit .env itself.

# Postgres connection string (pooled) — Vercel Storage -> Postgres, or Neon/Supabase.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional: unpooled connection string for `prisma migrate dev`'s shadow database.
# Leave unset (don't set to "") to fall back to DATABASE_URL_UNPOOLED/DATABASE_URL.
# DIRECT_URL=""

# Vercel Blob read/write token — Vercel Storage -> Blob -> .env.local tab.
BLOB_READ_WRITE_TOKEN=""

# Random secret for NextAuth session encryption. Generate with: openssl rand -base64 32
# Also encrypts integration secrets (the Razorpay Key Secret in Settings -> Integrations);
# changing it means pasting those keys in again.
AUTH_SECRET=""

# Used once by `npm run db:seed` to create the first admin user.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@yourcompany.com"
SEED_ADMIN_PASSWORD="change-me-immediately"

# Outgoing mail, used to send invoices to customers.
# For Zoho Mail: host smtp.zoho.com, port 465. Use smtp.zoho.com even for a .in
# domain unless the mailbox really lives in the India data centre — the wrong
# host fails with "535 Authentication Failed", which looks like a bad password.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Mirrors Mulberry payments into the studio's Google Sheet. Both come from
# google-apps-script/PaymentSync.gs — the /exec URL of its web app deployment,
# and the same random string as the SECRET at the top of that file. Leave
# either blank and payments simply aren't mirrored.
SHEETS_WEBHOOK_URL=""
SHEETS_WEBHOOK_SECRET=""

# The IPC Finance and IWC Finance workbooks, one copy of the same script in
# each (set its RECEIPT_COLUMNS to that workbook's layout). A different secret
# per workbook. Leave a pair blank and that venture simply isn't mirrored.
SHEETS_WEBHOOK_URL_IPC=""
SHEETS_WEBHOOK_SECRET_IPC=""
SHEETS_WEBHOOK_URL_IWC=""
SHEETS_WEBHOOK_SECRET_IWC=""
