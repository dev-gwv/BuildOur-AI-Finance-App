# Copy to .env and fill in real values. Never commit .env itself.

# Postgres connection string (pooled) — Vercel Storage -> Postgres, or Neon/Supabase.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Optional: unpooled connection string for `prisma migrate dev`'s shadow database.
# Leave unset (don't set to "") to fall back to DATABASE_URL_UNPOOLED/DATABASE_URL.
# DIRECT_URL=""

# Vercel Blob read/write token — Vercel Storage -> Blob -> .env.local tab.
BLOB_READ_WRITE_TOKEN=""

# Random secret for NextAuth session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Used once by `npm run db:seed` to create the first admin user.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_EMAIL="admin@yourcompany.com"
SEED_ADMIN_PASSWORD="change-me-immediately"

# Outgoing mail, used to send invoices to customers.
# For Gmail / Google Workspace: host smtp.gmail.com, port 465. SMTP_PASS must be
# a 16-character app password (myaccount.google.com/apppasswords) — Google
# rejects the normal account password with "534 5.7.9 Application-specific
# password required".
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
